{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The tests read the desktop's source off disk; the source brings core's types, see tsconfig.src.json.
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "composite": true
  },
  "include": ["test/**/*.ts", "src/**/*.ts"]
}
